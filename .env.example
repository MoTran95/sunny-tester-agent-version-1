# Mẫu file .env cho máy mới. Chép thành .env rồi tự điền giá trị (đừng gửi mật khẩu qua chat).
# .env không được commit (đã có trong .gitignore). Claude vẫn không tự gõ mật khẩu vào form đăng nhập.
# Mỗi dự án một nhóm khóa, tiền tố = slug viết HOA, gạch ngang thành gạch dưới (banking-lite -> BANKING_LITE_).
# Chỉ cần điền nhóm của dự án đang làm trên máy này.

# Dự án banking-lite
BANKING_LITE_URL=https://banking-lite.vercel.app/
BANKING_LITE_P100001_USER=P100001
BANKING_LITE_P100001_PASSWORD=
BANKING_LITE_P200001_USER=P200001
BANKING_LITE_P200001_PASSWORD=
BANKING_LITE_P300001_USER=P300001
BANKING_LITE_P300001_PASSWORD=
